{
    "theme": "material-palenight",
    "ascii": "~/.config/xfetch/logos/alma.txt",
    "layout": "section-box",
    "show_colors": true,
    "colors": {
        "os": "#FF5370",
        "kernel": "#7FDBCA",
        "hostname": "#82AAFF",
        "uptime": "#F78C6C",
        "packages": "#89DDFF",
        "shell": "#A6ACCD",
        "terminal": "#FFCB6B",
        "wm": "#C792EA",
        "cpu": "#FF5370",
        "gpu": "#7FDBCA",
        "memory": "#82AAFF",
        "swap": "#F78C6C",
        "disk": "#89DDFF",
        "battery": "#A6ACCD",
        "user": "#FFCB6B",
        "datetime": "#C792EA",
        "local_ip": "#FF5370",
        "interfaces": "#82AAFF",
        "palette": "#F78C6C",
        "plugin:docker": "#82AAFF",
        "plugin:github-stats": "#F78C6C",
        "plugin:music-player": "#89DDFF",
        "plugin:weather": "#A6ACCD",
        "plugin:timezone": "#FFCB6B",
        "plugin:user-info": "#C792EA",
        "plugin:display-resolution": "#FF5370",
        "plugin:theme-detection": "#7FDBCA",
        "plugin:temperature": "#82AAFF",
        "plugin:gauges": "#82AAFF"
    },
    "logo_color": "#C792EA",
    "modules": [
        "os",
        "wm",
        "shell",
        "plugin:gauges"
    ],
    "info_plugins": [
        {
            "plugin": "gauges",
            "args": {
                "style": "slashes",
                "width": 10,
                "metrics": [
                    "memory",
                    "swap",
                    "disk",
                    "battery"
                ],
                "include_tmpfs": true,
                "glyphs": "jp"
            },
            "timeout_secs": 3
        }
    ],
    "icons": {
        "os": "系",
        "kernel": "核",
        "hostname": "名",
        "uptime": "時",
        "packages": "包",
        "shell": "殻",
        "terminal": "端",
        "wm": "窓",
        "cpu": "芯",
        "gpu": "顕",
        "memory": "存",
        "swap": "換",
        "disk": "盤",
        "battery": "電",
        "user": "用",
        "datetime": "日",
        "local_ip": "網",
        "interfaces": "網",
        "palette": "色"
    },
    "labels": {
        "plugin:gauges": ""
    },
    "logo_animation": {
        "plugin": "banner",
        "style": "banner",
        "timeout_secs": 3
    },
    "os_wsl_style": "minimal",
    "logo_gap": 10
}
