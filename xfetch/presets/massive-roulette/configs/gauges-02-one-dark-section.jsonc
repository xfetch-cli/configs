{
    "theme": "one-dark",
    "ascii": "~/.config/xfetch/logos/alma.txt",
    "layout": "section",
    "show_colors": true,
    "colors": {
        "os": "#D19A66",
        "kernel": "#C678DD",
        "hostname": "#61AFEF",
        "uptime": "#E06C75",
        "packages": "#ABB2BF",
        "shell": "#BE5046",
        "terminal": "#56B6C2",
        "wm": "#E5C07B",
        "cpu": "#98C379",
        "gpu": "#D19A66",
        "memory": "#C678DD",
        "swap": "#61AFEF",
        "disk": "#E06C75",
        "battery": "#ABB2BF",
        "user": "#BE5046",
        "datetime": "#56B6C2",
        "local_ip": "#E5C07B",
        "interfaces": "#D19A66",
        "palette": "#C678DD",
        "plugin:docker": "#98C379",
        "plugin:github-stats": "#D19A66",
        "plugin:music-player": "#C678DD",
        "plugin:weather": "#61AFEF",
        "plugin:timezone": "#E06C75",
        "plugin:user-info": "#ABB2BF",
        "plugin:display-resolution": "#BE5046",
        "plugin:theme-detection": "#56B6C2",
        "plugin:temperature": "#E5C07B",
        "plugin:gauges": "#C678DD"
    },
    "logo_color": "#ABB2BF",
    "modules": [
        "os",
        "hostname",
        "plugin:gauges"
    ],
    "info_plugins": [
        {
            "plugin": "gauges",
            "args": {
                "style": "slashes",
                "width": 12,
                "metrics": [
                    "memory",
                    "swap"
                ],
                "glyphs": "jp"
            },
            "timeout_secs": 3
        }
    ],
    "icons": {
        "os": "系",
        "kernel": "核",
        "hostname": "名",
        "uptime": "時",
        "packages": "包",
        "shell": "殻",
        "terminal": "端",
        "wm": "窓",
        "cpu": "芯",
        "gpu": "顕",
        "memory": "存",
        "swap": "換",
        "disk": "盤",
        "battery": "電",
        "user": "用",
        "datetime": "日",
        "local_ip": "網",
        "interfaces": "網",
        "palette": "色"
    },
    "labels": {
        "plugin:gauges": ""
    },
    "logo_animation": {
        "plugin": "banner",
        "style": "banner",
        "timeout_secs": 3
    },
    "os_wsl_style": "minimal",
    "logo_gap": 14
}
