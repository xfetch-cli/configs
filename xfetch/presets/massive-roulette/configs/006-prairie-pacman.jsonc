{
    "theme": "prairie",
    "ascii": "~/.config/xfetch/logos/rhel.txt",
    "layout": "pacman",
    "show_colors": true,
    "colors": {
        "os": "#DF8D2E",
        "kernel": "#25E38B",
        "hostname": "#9241DA",
        "uptime": "#E61778",
        "packages": "#4F9DF8",
        "shell": "#7ECC3A",
        "terminal": "#DF8D2E",
        "wm": "#25E38B",
        "cpu": "#9241DA",
        "gpu": "#E61778",
        "memory": "#4F9DF8",
        "swap": "#7ECC3A",
        "disk": "#DF8D2E",
        "battery": "#25E38B",
        "user": "#9241DA",
        "datetime": "#E61778",
        "local_ip": "#4F9DF8",
        "interfaces": "#DF8D2E",
        "palette": "#25E38B",
        "plugin:docker": "#4F9DF8",
        "plugin:github-stats": "#7ECC3A",
        "plugin:music-player": "#DF8D2E",
        "plugin:weather": "#25E38B",
        "plugin:timezone": "#9241DA",
        "plugin:user-info": "#E61778",
        "plugin:display-resolution": "#4F9DF8",
        "plugin:theme-detection": "#7ECC3A",
        "plugin:temperature": "#DF8D2E",
        "plugin:gauges": "#4F9DF8"
    },
    "logo_color": "#25E38B",
    "modules": [
        "os",
        "terminal",
        "memory",
        "shell",
        "battery",
        "datetime",
        "gpu",
        "packages",
        "kernel",
        "interfaces",
        "plugin:gauges"
    ],
    "icons": {
        "os": "系",
        "kernel": "核",
        "hostname": "名",
        "uptime": "時",
        "packages": "包",
        "shell": "殻",
        "terminal": "端",
        "wm": "窓",
        "cpu": "芯",
        "gpu": "顕",
        "memory": "存",
        "swap": "換",
        "disk": "盤",
        "battery": "電",
        "user": "用",
        "datetime": "日",
        "local_ip": "網",
        "interfaces": "網",
        "palette": "色"
    },
    "formats": {
        "gpu": "{name}",
        "memory": "{used} / {total}",
        "os": "{distro}",
        "battery": "{percent}% [{state}]"
    },
    "os_wsl_style": "minimal",
    "logo_gap": 14,
    "header_icons": [
        "",
        "",
        "",
        ""
    ],
    "footer_text": "READY!",
    "disable_cache": true,
    "info_plugins": [
        {
            "plugin": "gauges",
            "args": {
                "style": "slashes",
                "width": 14,
                "metrics": [
                    "swap",
                    "disk"
                ],
                "glyphs": "jp"
            },
            "timeout_secs": 3
        }
    ],
    "labels": {
        "plugin:gauges": ""
    },
    "logo_animation": {
        "plugin": "banner",
        "style": "banner",
        "timeout_secs": 3
    }
}
