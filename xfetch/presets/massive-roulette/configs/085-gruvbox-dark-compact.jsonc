{
    "theme": "gruvbox-dark",
    "ascii": "~/.config/xfetch/logos/alpine.txt",
    "layout": "compact",
    "show_colors": true,
    "colors": {
        "os": "#83A598",
        "kernel": "#EBDBB2",
        "hostname": "#D79921",
        "uptime": "#98971A",
        "packages": "#458588",
        "shell": "#B16286",
        "terminal": "#689D6A",
        "wm": "#FB4934",
        "cpu": "#FE8019",
        "gpu": "#83A598",
        "memory": "#EBDBB2",
        "swap": "#D79921",
        "disk": "#98971A",
        "battery": "#458588",
        "user": "#B16286",
        "datetime": "#689D6A",
        "local_ip": "#FB4934",
        "interfaces": "#83A598",
        "palette": "#EBDBB2",
        "plugin:docker": "#D79921",
        "plugin:github-stats": "#98971A",
        "plugin:music-player": "#458588",
        "plugin:weather": "#B16286",
        "plugin:timezone": "#689D6A",
        "plugin:user-info": "#FB4934",
        "plugin:display-resolution": "#FE8019",
        "plugin:theme-detection": "#83A598",
        "plugin:temperature": "#EBDBB2"
    },
    "logo_color": "#98971A",
    "modules": [
        "os",
        "packages",
        "datetime",
        "plugin:theme-detection",
        "plugin:music-player"
    ],
    "info_plugins": [
        {
            "plugin": "theme-detection",
            "timeout_secs": 4
        },
        {
            "plugin": "music-player",
            "timeout_secs": 4
        }
    ],
    "icons": {},
    "labels": {
        "memory": "RAM",
        "swap": "SWAP",
        "disk": "DISCO",
        "packages": "PKGS"
    },
    "formats": {
        "packages": "{count} ({manager})"
    },
    "os_wsl_style": "minimal",
    "logo_gap": 10,
    "logo_padding": 0,
    "disable_cache": true
}
