{
    "theme": "solarized-light",
    "ascii": "~/.config/xfetch/logos/archbang.txt",
    "layout": "minimal",
    "show_colors": true,
    "colors": {
        "os": "#CB4B16",
        "kernel": "#859900",
        "hostname": "#268BD2",
        "uptime": "#6C71C4",
        "packages": "#DC322F",
        "shell": "#B58900",
        "terminal": "#2AA198",
        "wm": "#586E75",
        "cpu": "#D33682",
        "gpu": "#CB4B16",
        "memory": "#859900",
        "swap": "#268BD2",
        "disk": "#6C71C4",
        "battery": "#DC322F",
        "user": "#B58900",
        "datetime": "#2AA198",
        "local_ip": "#586E75",
        "interfaces": "#CB4B16",
        "palette": "#859900",
        "plugin:docker": "#D33682",
        "plugin:github-stats": "#CB4B16",
        "plugin:music-player": "#859900",
        "plugin:weather": "#268BD2",
        "plugin:timezone": "#6C71C4",
        "plugin:user-info": "#DC322F",
        "plugin:display-resolution": "#B58900",
        "plugin:theme-detection": "#2AA198",
        "plugin:temperature": "#586E75"
    },
    "logo_color": "#D33682",
    "modules": [
        "os",
        "interfaces",
        "user",
        "packages",
        "datetime",
        "plugin:theme-detection"
    ],
    "info_plugins": [
        {
            "plugin": "theme-detection",
            "timeout_secs": 4
        }
    ],
    "icons": {},
    "labels": {
        "cpu": "CPU",
        "gpu": "GPU",
        "memory": "MEM",
        "shell": "sh",
        "wm": "WM"
    },
    "formats": {
        "os": "{distro} · {arch}"
    },
    "palette_style": "triangles",
    "os_wsl_style": "minimal",
    "show_keys": true,
    "key_width": 10,
    "logo_gap": 14
}
