{
    "theme": "amethyst",
    "ascii": "~/.config/xfetch/logos/antix.txt",
    "layout": "dots",
    "show_colors": true,
    "colors": {
        "os": "#C75963",
        "kernel": "#FAED40",
        "hostname": "#6FFA67",
        "uptime": "#5FD4CA",
        "packages": "#5763FA",
        "shell": "#E148E9",
        "terminal": "#C75963",
        "wm": "#FAED40",
        "cpu": "#6FFA67",
        "gpu": "#5FD4CA",
        "memory": "#5763FA",
        "swap": "#E148E9",
        "disk": "#C75963",
        "battery": "#FAED40",
        "user": "#6FFA67",
        "datetime": "#5FD4CA",
        "local_ip": "#5763FA",
        "interfaces": "#C75963",
        "palette": "#FAED40",
        "plugin:docker": "#6FFA67",
        "plugin:github-stats": "#5FD4CA",
        "plugin:music-player": "#5763FA",
        "plugin:weather": "#E148E9",
        "plugin:timezone": "#C75963",
        "plugin:user-info": "#FAED40",
        "plugin:display-resolution": "#6FFA67",
        "plugin:theme-detection": "#5FD4CA",
        "plugin:temperature": "#5763FA"
    },
    "logo_color": "#6FFA67",
    "modules": [
        "os",
        "datetime",
        "shell",
        "gpu",
        "disk",
        "hostname",
        "user",
        "packages",
        "wm",
        "swap",
        "kernel"
    ],
    "icons": {},
    "labels": {
        "os": "distro",
        "kernel": "kernel",
        "terminal": "term",
        "uptime": "up"
    },
    "formats": {
        "os": "{distro}"
    },
    "os_wsl_style": "minimal",
    "logo_gap": 14,
    "logo_animation": {
        "plugin": "animate-logo",
        "style": "breathing",
        "fps": 12,
        "duration_ms": 2200,
        "loop": false
    }
}
