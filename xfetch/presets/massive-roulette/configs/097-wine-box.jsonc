{
    "theme": "wine",
    "ascii": "~/.config/xfetch/logos/bodhi.txt",
    "layout": "box",
    "show_colors": true,
    "colors": {
        "os": "#3167BC",
        "kernel": "#16DA96",
        "hostname": "#B13F2E",
        "uptime": "#B3305E",
        "packages": "#D18815",
        "shell": "#51B6C5",
        "terminal": "#3167BC",
        "wm": "#16DA96",
        "cpu": "#B13F2E",
        "gpu": "#B3305E",
        "memory": "#D18815",
        "swap": "#51B6C5",
        "disk": "#3167BC",
        "battery": "#16DA96",
        "user": "#B13F2E",
        "datetime": "#B3305E",
        "local_ip": "#D18815",
        "interfaces": "#3167BC",
        "palette": "#16DA96",
        "plugin:docker": "#B13F2E",
        "plugin:github-stats": "#B3305E",
        "plugin:music-player": "#D18815",
        "plugin:weather": "#51B6C5",
        "plugin:timezone": "#3167BC",
        "plugin:user-info": "#16DA96",
        "plugin:display-resolution": "#B13F2E",
        "plugin:theme-detection": "#B3305E",
        "plugin:temperature": "#D18815"
    },
    "logo_color": "#51B6C5",
    "modules": [
        "os",
        "user",
        "disk",
        "datetime",
        "local_ip",
        "cpu",
        "hostname",
        "gpu"
    ],
    "icons": {},
    "formats": {
        "cpu": "{model} · {cores} núcleos",
        "gpu": "{name}",
        "disk": "{used}/{total} ({fs})",
        "os": "{distro} {version}",
        "datetime": "{value}"
    },
    "palette_style": "triangles",
    "os_wsl_style": "off",
    "logo_gap": 12
}
