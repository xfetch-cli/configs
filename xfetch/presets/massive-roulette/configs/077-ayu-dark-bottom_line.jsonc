{
    "theme": "ayu-dark",
    "ascii": "~/.config/xfetch/logos/mx-linux.txt",
    "layout": "bottom_line",
    "show_colors": true,
    "colors": {
        "os": "#FF6A69",
        "kernel": "#BA76E4",
        "hostname": "#F07178",
        "uptime": "#B3B1AD",
        "packages": "#E6B450",
        "shell": "#39BAE6",
        "terminal": "#95E6CB",
        "wm": "#FFB454",
        "cpu": "#FF8F40",
        "gpu": "#FF6A69",
        "memory": "#BA76E4",
        "swap": "#F07178",
        "disk": "#B3B1AD",
        "battery": "#E6B450",
        "user": "#39BAE6",
        "datetime": "#95E6CB",
        "local_ip": "#FFB454",
        "interfaces": "#FF6A69",
        "palette": "#BA76E4",
        "plugin:docker": "#F07178",
        "plugin:github-stats": "#B3B1AD",
        "plugin:music-player": "#E6B450",
        "plugin:weather": "#39BAE6",
        "plugin:timezone": "#95E6CB",
        "plugin:user-info": "#FFB454",
        "plugin:display-resolution": "#FF8F40",
        "plugin:theme-detection": "#FF6A69",
        "plugin:temperature": "#BA76E4"
    },
    "logo_color": "#F07178",
    "modules": [
        "os",
        "battery",
        "uptime",
        "cpu",
        "user",
        "wm",
        "terminal",
        "memory",
        "gpu",
        "local_ip",
        "palette"
    ],
    "icons": {},
    "labels": {
        "memory": "RAM",
        "swap": "SWAP",
        "disk": "DISCO",
        "packages": "PKGS"
    },
    "formats": {
        "gpu": "{value}",
        "uptime": "{value}"
    },
    "os_wsl_style": "full",
    "show_keys": true,
    "key_width": 8,
    "logo_gap": 12,
    "logo_padding": 2
}
