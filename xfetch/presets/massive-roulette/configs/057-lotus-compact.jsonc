{
    "theme": "lotus",
    "ascii": "~/.config/xfetch/logos/blackarch.txt",
    "layout": "compact",
    "show_colors": true,
    "colors": {
        "os": "#63E13B",
        "kernel": "#33EAC2",
        "hostname": "#3767F3",
        "uptime": "#BE44E4",
        "packages": "#CB5770",
        "shell": "#C0A34F",
        "terminal": "#63E13B",
        "wm": "#33EAC2",
        "cpu": "#3767F3",
        "gpu": "#BE44E4",
        "memory": "#CB5770",
        "swap": "#C0A34F",
        "disk": "#63E13B",
        "battery": "#33EAC2",
        "user": "#3767F3",
        "datetime": "#BE44E4",
        "local_ip": "#CB5770",
        "interfaces": "#63E13B",
        "palette": "#33EAC2",
        "plugin:docker": "#3767F3",
        "plugin:github-stats": "#BE44E4",
        "plugin:music-player": "#CB5770",
        "plugin:weather": "#C0A34F",
        "plugin:timezone": "#63E13B",
        "plugin:user-info": "#33EAC2",
        "plugin:display-resolution": "#3767F3",
        "plugin:theme-detection": "#BE44E4",
        "plugin:temperature": "#CB5770"
    },
    "logo_color": "#63E13B",
    "modules": [
        "os",
        "swap",
        "palette",
        "memory",
        "terminal",
        "disk",
        "cpu",
        "interfaces"
    ],
    "icons": {},
    "formats": {
        "memory": "{used}/{total} ({percent}%)",
        "os": "{distro}"
    },
    "os_wsl_style": "full",
    "show_keys": true,
    "key_width": 8,
    "logo_gap": 8,
    "logo_colors": [
        "#63E13B",
        "#33EAC2",
        "#3767F3",
        "#BE44E4",
        "#CB5770",
        "#C0A34F"
    ]
}
