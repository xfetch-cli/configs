{
    "theme": "arcade",
    "ascii": "~/.config/xfetch/logos/bodhi.txt",
    "layout": "side-block",
    "show_colors": true,
    "colors": {
        "os": "#20D329",
        "kernel": "#BF457E",
        "hostname": "#DF3DD6",
        "uptime": "#C03937",
        "packages": "#47BB85",
        "shell": "#35B4B6",
        "terminal": "#20D329",
        "wm": "#BF457E",
        "cpu": "#DF3DD6",
        "gpu": "#C03937",
        "memory": "#47BB85",
        "swap": "#35B4B6",
        "disk": "#20D329",
        "battery": "#BF457E",
        "user": "#DF3DD6",
        "datetime": "#C03937",
        "local_ip": "#47BB85",
        "interfaces": "#20D329",
        "palette": "#BF457E",
        "plugin:docker": "#DF3DD6",
        "plugin:github-stats": "#C03937",
        "plugin:music-player": "#47BB85",
        "plugin:weather": "#35B4B6",
        "plugin:timezone": "#20D329",
        "plugin:user-info": "#BF457E",
        "plugin:display-resolution": "#DF3DD6",
        "plugin:theme-detection": "#C03937",
        "plugin:temperature": "#47BB85"
    },
    "logo_color": "#47BB85",
    "modules": [
        "os",
        "disk",
        "uptime",
        "memory",
        "datetime",
        "cpu",
        "terminal",
        "interfaces"
    ],
    "icons": {},
    "labels": {
        "hostname": "",
        "user": "",
        "kernel": "krnl"
    },
    "formats": {
        "cpu": "{value}",
        "memory": "{used} / {total}",
        "disk": "{value}",
        "os": "{value}",
        "uptime": "{value}"
    },
    "os_wsl_style": "minimal",
    "show_keys": true,
    "key_width": 8,
    "logo_gap": 10
}
