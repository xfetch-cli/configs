{
    "theme": "dracula-soft",
    "ascii": "~/.config/xfetch/logos/nixos.txt",
    "layout": "tree",
    "show_colors": true,
    "colors": {
        "os": "#8BE9FD",
        "kernel": "#50FA7B",
        "hostname": "#FFB86C",
        "uptime": "#FF79C6",
        "packages": "#BD93F9",
        "shell": "#FF5555",
        "terminal": "#F1FA8C",
        "wm": "#6272A4",
        "cpu": "#F5F5F5",
        "gpu": "#8BE9FD",
        "memory": "#50FA7B",
        "swap": "#FFB86C",
        "disk": "#FF79C6",
        "battery": "#BD93F9",
        "user": "#FF5555",
        "datetime": "#F1FA8C",
        "local_ip": "#6272A4",
        "interfaces": "#8BE9FD",
        "palette": "#50FA7B",
        "plugin:docker": "#FFB86C",
        "plugin:github-stats": "#FF79C6",
        "plugin:music-player": "#BD93F9",
        "plugin:weather": "#FF5555",
        "plugin:timezone": "#F1FA8C",
        "plugin:user-info": "#6272A4",
        "plugin:display-resolution": "#F5F5F5",
        "plugin:theme-detection": "#8BE9FD",
        "plugin:temperature": "#50FA7B"
    },
    "logo_color": "#FFB86C",
    "modules": [
        {
            "type": "group",
            "title": "Core",
            "modules": [
                "os",
                "interfaces",
                "uptime"
            ]
        },
        {
            "type": "group",
            "title": "Devices",
            "modules": [
                "datetime",
                "swap",
                "plugin:temperature"
            ]
        },
        {
            "type": "group",
            "title": "Session",
            "modules": [
                "gpu"
            ]
        }
    ],
    "info_plugins": [
        {
            "plugin": "temperature",
            "timeout_secs": 4,
            "args": {
                "unit": "celsius"
            }
        }
    ],
    "icons": {},
    "formats": {
        "gpu": "{value}",
        "os": "{distro}",
        "datetime": "{time}"
    },
    "palette_style": "squares",
    "os_wsl_style": "full",
    "logo_gap": 10
}
