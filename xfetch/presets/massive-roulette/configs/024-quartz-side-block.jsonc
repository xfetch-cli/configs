{
    "theme": "quartz",
    "ascii": "~/.config/xfetch/logos/x.txt",
    "layout": "side-block",
    "show_colors": true,
    "colors": {
        "os": "#C86779",
        "kernel": "#7CEB64",
        "hostname": "#E2CC66",
        "uptime": "#B54DCD",
        "packages": "#3DD8BB",
        "shell": "#6F81D3",
        "terminal": "#C86779",
        "wm": "#7CEB64",
        "cpu": "#E2CC66",
        "gpu": "#B54DCD",
        "memory": "#3DD8BB",
        "swap": "#6F81D3",
        "disk": "#C86779",
        "battery": "#7CEB64",
        "user": "#E2CC66",
        "datetime": "#B54DCD",
        "local_ip": "#3DD8BB",
        "interfaces": "#C86779",
        "palette": "#7CEB64",
        "plugin:docker": "#E2CC66",
        "plugin:github-stats": "#B54DCD",
        "plugin:music-player": "#3DD8BB",
        "plugin:weather": "#6F81D3",
        "plugin:timezone": "#C86779",
        "plugin:user-info": "#7CEB64",
        "plugin:display-resolution": "#E2CC66",
        "plugin:theme-detection": "#B54DCD",
        "plugin:temperature": "#3DD8BB"
    },
    "logo_color": "#7CEB64",
    "modules": [
        "os",
        "terminal",
        "memory",
        "disk",
        "local_ip",
        "battery",
        "user",
        "hostname"
    ],
    "icons": {},
    "formats": {
        "memory": "{used} / {total}",
        "disk": "{used} / {total}",
        "os": "{distro} · {arch}",
        "battery": "{percent}%"
    },
    "os_wsl_style": "minimal",
    "logo_gap": 14,
    "disable_ip_fetching": true,
    "logo_animation": {
        "plugin": "animate-logo",
        "style": "rainbow",
        "fps": 10,
        "duration_ms": 1400,
        "loop": false
    }
}
