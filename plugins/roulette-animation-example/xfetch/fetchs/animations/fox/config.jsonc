{
    "daemon": true,
    "daemon_min_rows": 6,
    "layout": "pacman",
    "palette_style": "circles",
    "show_colors": true,
    "ascii": "~/.config/xfetch/logos/animations/fox_static.txt",
    "logo_animation": {
        "plugin": "animate-logo",
        "style": "frame",
        "fps": 6,
        "duration_ms": 8000,
        "loop": true,
        "frames_path": "~/.config/xfetch/logos/animations/fox.txt"
    },
    "modules": [
        "hostname",
        "os",
        "kernel",
        "uptime",
        "packages",
        "wm",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "palette"
    ],
    "icons": {
        "hostname": "",
        "os": "",
        "kernel": "",
        "uptime": "󰔛",
        "packages": "",
        "wm": "",
        "shell": "",
        "terminal": "",
        "cpu": "",
        "gpu": "󰍹",
        "memory": "",
        "disk": "󰋊",
        "palette": "P"
    },
    "colors": {
        "hostname": "Green",
        "os": "Yellow",
        "kernel": "Yellow",
        "uptime": "Magenta",
        "packages": "Cyan",
        "wm": "Blue",
        "shell": "Red",
        "terminal": "Red",
        "cpu": "Green",
        "gpu": "Magenta",
        "memory": "Blue",
        "disk": "Cyan",
        "palette": "White"
    }
}
